# Clash of Clans API (used only by the sync process)
COC_API_TOKEN=
COC_CLAN_TAG=#YOUR_CLAN_TAG

# Separate Supabase project for this Discord data layer
# Sync process: service-role key (write access)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Discord bot
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# AI provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional alternative provider for a later phase
AI_PROVIDER=gemini
SARVAM_API_KEY=
SARVAM_MODEL=

# Polling intervals (milliseconds)
CLAN_POLL_MS=600000
WAR_POLL_MS=120000
PLAYER_POLL_MS=1800000
