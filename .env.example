# Clash of Clans API
COC_API_TOKEN=
COC_CLAN_TAG=#YOUR_CLAN_TAG

# Dedicated Supabase project for this bot/data layer
SUPABASE_URL=
# WRITE/SYNC SERVICE: never expose this to Discord or AI
SUPABASE_SERVICE_ROLE_KEY=
# READ-ONLY/AI: use anon key with appropriate RLS policies
SUPABASE_ANON_KEY=

# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
# Optional: channel that receives AI answers when a user presses Forward
AI_FORWARD_CHANNEL_ID=

# AI
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Gemini 3.8 is the default; /tell automatically falls back across stable Flash models on temporary failures.
GEMINI_MODEL=gemini-3.8-flash
# /ask uses Sarvam's conversational model for the faster everyday path.
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b-conversations

# Polling intervals (milliseconds)
CLAN_POLL_MS=600000
WAR_POLL_MS=120000
HISTORY_POLL_MS=1800000
CAPITAL_POLL_MS=1800000
CWL_POLL_MS=300000
PLAYER_POLL_MS=1800000
# API history page sizes
WARLOG_PAGE_LIMIT=100
CAPITAL_PAGE_LIMIT=100
PORT=3000
