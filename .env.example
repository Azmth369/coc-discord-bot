# Clash of Clans API
COC_API_TOKEN=
COC_CLAN_TAG=#YOUR_CLAN_TAG

# Separate Supabase project for the Discord data layer
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# AI provider: gemini or sarvam
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Sarvam
SARVAM_API_KEY=
SARVAM_MODEL=

# Polling intervals in milliseconds
CLAN_POLL_MS=600000
WAR_POLL_MS=120000
PLAYER_POLL_MS=1800000

# Limit how much history is initially fetched
WARLOG_PAGE_LIMIT=1
